{
  "name": "lecturepulse-backend",
  "version": "1.0.0",
  "description": "Traditional Node.js + Express + PostgreSQL backend for LecturePulse 2.0",
  "main": "dist/index.js",
  "engines": { "node": ">=22 <25" },
  "overrides": { "gaxios@6.7.1": { "uuid": "11.1.1" } },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "test:storage": "npm run build && node --test scripts/test-storage-paths.mjs",
    "test:audio": "npm run build && node --test scripts/test-wav-audio.mjs",
    "test:rag": "npm run build && node --test scripts/test-rag-retrieval.mjs",
    "test:security": "npm run build && node --test scripts/test-security.mjs",
    "test:access": "npm run build && node --test scripts/test-access-control.mjs",
    "test:media": "npm run build && node --test scripts/test-wav-audio.mjs scripts/test-storage-paths.mjs scripts/test-youtube-paths.mjs",
    "start": "node dist/index.js",
    "postinstall": "prisma generate && node scripts/install-media-tools.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "groq-sdk": "^0.15.0",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "youtubei.js": "^17.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.24",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  }
}
