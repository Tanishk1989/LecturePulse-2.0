{
  "name": "lecturepulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": { "@grpc/grpc-js": "~1.13.6" },
  "scripts": {
    "test:features": "node --test scripts/test-feature-recovery.mjs scripts/test-collection-recovery.mjs",
    "test:push": "node --test scripts/test-push-worker.mjs",
    "test:sync": "node --test scripts/test-account-sync.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:markdown": "node --experimental-strip-types --test scripts/test-markdown.mjs",
    "test:recovery": "node --test scripts/test-page-recovery.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:functions": "powershell -ExecutionPolicy Bypass -File scripts/deploy-edge-functions.ps1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.20.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
