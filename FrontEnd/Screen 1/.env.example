# Copy to `.env` in this folder (Screen 1) for local development.
# Set the production value in Vercel as well.
VITE_BACKEND_URL=http://localhost:5000/api

# Production:
# VITE_BACKEND_URL=https://lecturepulse-api-tanishk.onrender.com/api
# VITE_BACKEND_URL_OVERRIDE can replace a previously configured VITE_BACKEND_URL.

# Optional — legacy Supabase client is unused; Postgres is configured on the backend only
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
